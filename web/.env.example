# Identifiant de mesure Google Analytics 4 (format G-XXXXXXXXXX).
# Créé dans Google Analytics : Admin > Créer une propriété > Flux de données web.
# Copier ce fichier en .env et renseigner la valeur pour activer le tracking
# (rien n'est chargé si la variable est absente ou vide).
PUBLIC_GA_ID=

# Code de vérification de propriété Google Search Console (méthode "balise HTML").
# Search Console > Ajouter une propriété > préfixe d'URL > méthode "Balise HTML" :
# copier uniquement la valeur de l'attribut content= de la balise fournie.
PUBLIC_GOOGLE_SITE_VERIFICATION=
