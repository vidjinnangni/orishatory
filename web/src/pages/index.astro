---
import BaseLayout from "../layouts/BaseLayout.astro";
import RegionIcon from "../components/RegionIcon.astro";
import { REGIONS, REGION_LABELS, REGION_DESCRIPTIONS } from "../lib/constants";
import { ALL_ENTITIES, getEntitiesByRegion } from "../lib/data";

const regionCounts = REGIONS.map((region) => ({
  region,
  count: getEntitiesByRegion(region).length,
}));

const description =
  "Codex ouvert et sourcé des mythologies africaines et de leurs diasporas : divinités, héros, créatures, récits et rites, organisés par grande aire culturelle plutôt que comme un bloc uniforme.";

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Orishatory",
  url: Astro.site?.toString(),
  description,
  potentialAction: {
    "@type": "SearchAction",
    target: `${Astro.site}recherche/?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout title="Orishatory — Codex des mythologies africaines et de leurs diasporas" appendSiteName={false} description={description} jsonLd={websiteJsonLd}>
  <section class="hero container">
    <!-- <p class="eyebrow">Base de données ouverte</p> -->
    <h1>Les mythologies du continent africain et de ses diasporas</h1>
    <p class="lede">
      {ALL_ENTITIES.length} fiches sourcées : divinités, héros, créatures, récits et rites
      organisées par grande aire culturelle.
    </p>
  </section>

  <section class="container regions" aria-label="Régions">
    <ul class="region-grid">
      {
        regionCounts.map(({ region, count }) => (
          <li>
            <a class="region-card" href={`/${region}/`}>
              <RegionIcon region={region} />
              <h2>{REGION_LABELS[region]}</h2>
              <p>{REGION_DESCRIPTIONS[region]}</p>
              <p class="count">{count} fiche{count > 1 ? "s" : ""}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) 2rem;
  }

  .lede {
    max-width: 52ch;
    color: var(--fg-muted);
    font-size: 1.05rem;
  }

  .regions {
    padding-block: 1rem 4rem;
  }

  .region-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .region-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .region-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .region-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    text-decoration: none;
    color: var(--fg);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .region-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px oklch(0 0 0 / 0.07);
  }

  .region-card:active {
    transform: translateY(-1px) scale(0.99);
    transition-duration: 100ms;
  }

  .region-card :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--fg-muted);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .region-card:hover :global(svg) {
    transform: scale(1.08);
  }

  .region-card h2 {
    margin: 0;
    font-size: 1.2rem;
  }

  .region-card p {
    margin: 0;
    max-width: none;
    font-size: 0.9rem;
    color: var(--fg-muted);
  }

  .region-card .count {
    margin-top: auto;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--fg);
  }
</style>
