---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import RegionIcon from "../../components/RegionIcon.astro";
import {
  CATEGORIES,
  CATEGORY_DESCRIPTIONS,
  CATEGORY_LABELS,
  REGIONS,
  REGION_DESCRIPTIONS,
  REGION_LABELS,
  type Region,
} from "../../lib/constants";
import { getEntitiesByRegionAndCategorie } from "../../lib/data";

export function getStaticPaths() {
  return REGIONS.map((region) => ({ params: { region } }));
}

const { region } = Astro.params as { region: Region };

const categoryCounts = CATEGORIES.map((categorie) => ({
  categorie,
  count: getEntitiesByRegionAndCategorie(region, categorie).length,
}));

const breadcrumb = [{ label: "Accueil", href: "/" }, { label: REGION_LABELS[region] }];
---

<BaseLayout title={REGION_LABELS[region]} description={REGION_DESCRIPTIONS[region]} breadcrumb={breadcrumb}>
  <div class="container">
    <Breadcrumb items={breadcrumb} />
  </div>

  <section class="container intro">
    <h1><RegionIcon region={region} />{REGION_LABELS[region]}</h1>
    <p class="lede">{REGION_DESCRIPTIONS[region]}</p>
  </section>

  <section class="container categories" aria-label="Catégories">
    <ul class="category-grid">
      {
        categoryCounts
          .filter(({ count }) => count > 0)
          .map(({ categorie, count }) => (
            <li>
              <a class="category-card" href={`/${region}/${categorie}/`}>
                <CategoryIcon categorie={categorie} />
                <h2>{CATEGORY_LABELS[categorie]}</h2>
                <p>{CATEGORY_DESCRIPTIONS[categorie]}</p>
                <p class="count">
                  {count} fiche{count > 1 ? "s" : ""}
                </p>
              </a>
            </li>
          ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: 1rem 2rem;
  }

  .intro h1 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .intro h1 :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--fg-muted);
    flex-shrink: 0;
  }

  .lede {
    max-width: 60ch;
    color: var(--fg-muted);
  }

  .categories {
    padding-block: 0 4rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1.25rem;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    text-decoration: none;
    color: var(--fg);
    transition: border-color 0.15s ease;
  }

  .category-card:hover {
    border-color: var(--accent);
  }

  .category-card :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--fg-muted);
  }

  .category-card h2 {
    margin: 0;
    font-size: 1.1rem;
  }

  .category-card p {
    margin: 0;
    max-width: none;
    font-size: 0.88rem;
    color: var(--fg-muted);
  }

  .category-card .count {
    margin-top: auto;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--fg);
  }
</style>
