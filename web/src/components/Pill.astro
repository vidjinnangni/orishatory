---
interface Props {
  href?: string;
}

const { href } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag class="pill" href={href}>
  <slot />
</Tag>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    font-size: 0.8rem;
    padding: 0.25em 0.7em;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--fg-muted);
    text-decoration: none;
    background: var(--bg-elevated);
  }

  a.pill:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
