---
import CategoryBadge from "./CategoryBadge.astro";
import { entityHref, type Entite } from "../lib/data";

interface Props {
  entity: Entite;
  showCategory?: boolean;
}

const { entity, showCategory = true } = Astro.props;
---

<a class="card" href={entityHref(entity)}>
  <div class="card-head">
    <h3>{entity.nom}</h3>
    {showCategory && <CategoryBadge categorie={entity.categorie} />}
  </div>
  {entity.peuples.length > 0 && <p class="peuples">{entity.peuples.join(", ")}</p>}
  <p class="resume">{entity.resume}</p>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    text-decoration: none;
    color: var(--fg);
    height: 100%;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px oklch(0 0 0 / 0.07);
  }

  .card:active {
    transform: translateY(-1px) scale(0.99);
    transition-duration: 100ms;
  }

  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card-head h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .peuples {
    margin: 0;
    max-width: none;
    font-size: 0.8rem;
    color: var(--fg-muted);
    font-weight: 600;
  }

  .resume {
    margin: 0;
    max-width: none;
    font-size: 0.9rem;
    color: var(--fg-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
