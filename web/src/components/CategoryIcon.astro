---
import type { Categorie } from "../lib/constants";

interface Props {
  categorie: Categorie;
}

const { categorie } = Astro.props;
---

{
  categorie === "deites" && (
    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3l2 7 7 2-7 2-2 7-2-7-7-2 7-2 2-7Z" />
    </svg>
  )
}
{
  categorie === "heros" && (
    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
      <path d="M12 3l7 3v5c0 5-3 8.5-7 10-4-1.5-7-5-7-10V6l7-3Z" />
    </svg>
  )
}
{
  categorie === "creatures" && (
    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <circle cx="5.5" cy="10.5" r="2" />
      <circle cx="10" cy="6.5" r="2" />
      <circle cx="14" cy="6.5" r="2" />
      <circle cx="18.5" cy="10.5" r="2" />
      <ellipse cx="12" cy="16.5" rx="5.5" ry="4.2" />
    </svg>
  )
}
{
  categorie === "recits" && (
    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 6.5c-1.8-1.3-4.2-2-7-2-.8 0-1.5.2-1.5.9v12.2c0 .5.4.8 1 .8 2.9 0 5.3.7 7.5 2 2.2-1.3 4.6-2 7.5-2 .6 0 1-.3 1-.8V5.4c0-.7-.7-.9-1.5-.9-2.8 0-5.2.7-7 2Z" />
      <path d="M12 6.5V19" />
    </svg>
  )
}
{
  categorie === "rites" && (
    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
      <path d="M12 21c3.6 0 6.5-2.4 6.5-6 0-2.8-1.8-4.7-2.8-7-.6 1.7-1.5 2.6-2.4 2.6.6-2.8-.7-5.6-3-7.4.2 2.3-.9 4.1-2.6 5.9C6 10.8 5.5 12.8 5.5 15c0 3.6 2.9 6 6.5 6Z" />
    </svg>
  )
}
