---
const repoUrl = "https://github.com/vidjinnangni/orishatory";
---

<div class="contribute-card">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M9 6 4 12l5 6" />
    <path d="M15 6l5 6-5 6" />
  </svg>
  <h2>Contribuer</h2>
  <p>
    Orishatory est un codex ouvert : ajouter une fiche, corriger une source ou signaler une erreur
    se fait directement sur GitHub.
  </p>
  <a class="contribute-cta" href={repoUrl} target="_blank" rel="noopener">Voir sur GitHub</a>
</div>

<style>
  .contribute-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
  }

  .contribute-card svg {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--fg-muted);
  }

  .contribute-card h2 {
    margin: 0;
    font-size: 1rem;
  }

  .contribute-card p {
    margin: 0;
    max-width: none;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .contribute-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.4rem;
    padding: 0.6rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      transform 100ms var(--ease-out);
  }

  .contribute-cta:hover {
    border-color: var(--fg-muted);
  }

  .contribute-cta:active {
    transform: scale(0.96);
    transition-duration: 100ms;
  }
</style>
