---
const repoUrl = "https://github.com/vidjinnangni/orishatory";
const supportUrl = "https://buymeacoffee.com/vidjinnangnig";
---

<footer class="site-footer">
  <div class="container bar">
    <p>
      Orishatory · Base de données ouverte des mythologies africaines et de sa diaspora · <a
        href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a
      >
    </p>
    <div class="links">
      <a href="/confidentialite/">Confidentialité</a>
      <button type="button" id="manage-cookies">Gérer les cookies</button>
      <a class="icon-link" href={supportUrl} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 9h13v5.5A4.5 4.5 0 0 1 12.5 19h-4A4.5 4.5 0 0 1 4 14.5V9Z" />
          <path d="M17 10.5h1.5a2.5 2.5 0 1 1 0 5H17" />
          <path d="M8 3.5c0 .9-1 .9-1 1.8M12 3.5c0 .9-1 .9-1 1.8" />
        </svg>
        Soutenir le projet
      </a>
      <a class="icon-link" href={repoUrl} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 6 4 12l5 6" />
          <path d="M15 6l5 6-5 6" />
        </svg>
        Code source & contributions
      </a>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById("manage-cookies")?.addEventListener("click", function () {
    window.orishatoryConsent?.open();
  });
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding-block: 1.5rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .bar p {
    margin: 0;
    max-width: none;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .bar a,
  .bar button {
    color: var(--fg-muted);
    text-decoration-thickness: from-font;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .bar button {
    font: inherit;
    font-size: inherit;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .bar a:hover,
  .bar button:hover {
    color: var(--fg);
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .icon-link svg {
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .icon-link:hover svg {
    transform: scale(1.1);
  }
</style>
